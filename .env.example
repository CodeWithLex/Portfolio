# Free API Keys for Lex's Portfolio Chatbot
# Set NVIDIA_API_KEY, GEMINI_API_KEY, or GROQ_API_KEY in your Vercel Project Settings (Settings -> Environment Variables)

# 1. NVIDIA NIM Free API (DeepSeek): Get key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
# Optional model override (default: deepseek-ai/deepseek-v3 or deepseek-ai/deepseek-r1):
NVIDIA_MODEL=deepseek-ai/deepseek-v3

# 2. Google Gemini API (Free Tier): Get key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Or Groq API (Free Tier): Get key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
